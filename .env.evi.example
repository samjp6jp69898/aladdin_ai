# aladdin_ai EVI 環境變數範本（*.godev2.com）——只有 KEY，沒有值，可進 git。
# 用法：cp .env.evi.example .env.evi，填入真實值後 chmod 600（那份 .env.evi 不可進 git）。
# conn/*.sh、lib/env.cjs 會自動合併讀取本檔與其他 5 份 .env.*，不用手動 source。
#
# 目前 aladdin_ai/conn/*.sh 只有 archery-evi-login.sh 真的會用到 EVI_ARCHERY_*；
# 其餘幾組（ADMIN/PLATFORM/GR_DB/SR_DB/KIBANA）舊 .env 裡有值但目前沒有對應腳本
# 消費，先原樣保留在這份檔案，供之後需要時使用。

EVI_ARCHERY_URL=
EVI_ARCHERY_USER=
EVI_ARCHERY_PASS=

EVI_ADMIN_USER=
EVI_ADMIN_PASS=
EVI_PLATFORM_USER=
EVI_PLATFORM_PASS=

# 轉移測試 game record DB（evi game record 遷移測試；唯讀查詢用）
EVI_GR_DB_HOST=
EVI_GR_DB_PORT=
EVI_GR_DB_USER=
EVI_GR_DB_PASS=

# EVI StarRocks (game_record readonly)
EVI_SR_DB_HOST=
EVI_SR_DB_PORT=
EVI_SR_DB_USER=
EVI_SR_DB_PASS=

# evi Kibana (game-back-office logs)
EVI_KIBANA_URL=
EVI_KIBANA_GBO_DATAVIEW=
