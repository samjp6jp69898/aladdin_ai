# aladdin_ai UAT 環境變數範本（jxpre）——只有 KEY，沒有值，可進 git。
# 用法：cp .env.uat.example .env.uat，填入真實值後 chmod 600（那份 .env.uat 不可進 git）。
# conn/*.sh、lib/env.cjs 會自動合併讀取本檔與其他 5 份 .env.*，不用手動 source。
#
# admin-login.sh / platform-login.sh（target `jx --env uat`）/ kibana-logs.sh 已支援 uat；
# UAT_ARCHERY_* 目前仍無對應腳本，先原樣保留供之後需要時使用（唯讀 grounding 用）。

UAT_ARCHERY_URL=
UAT_ARCHERY_USER=
UAT_ARCHERY_PASS=

JX_PLATFORM_UAT_URL=
JX_PLATFORM_UAT_USER=
JX_PLATFORM_UAT_PASS=

UAT_ADMIN_URL=
UAT_ADMIN_USER=
UAT_ADMIN_PASS=

UAT_KIBANA_URL=