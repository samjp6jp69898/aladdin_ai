# aladdin_ai PROD 環境變數範本——只有 KEY，沒有值，可進 git。
# 用法：cp .env.prod.example .env.prod，填入真實值後 chmod 600（那份 .env.prod 不可進 git）。
# ⚠️ 正式環境：CLAUDE.md 硬規則「CQA grounding 嚴禁 production」——這份檔案的值
# 不得被 cqa-grounder / 任何自動化 agent 流程使用，目前也沒有任何 conn/*.sh 讀取
# 這份檔案。純粹是把根目錄 .env 裡本來就有的 prod 監控/後台帳密原樣保留位置。

ARCHERY_PROD_URL=
ARCHERY_PROD_USER=
ARCHERY_PROD_PASSWORD=

GRAFANA_PROD_URL=

# 本次不建自動化腳本，先備用
JX_PLATFORM_PROD_URL=
JX_PLATFORM_PROD_USER=
JX_PLATFORM_PROD_PASS=
