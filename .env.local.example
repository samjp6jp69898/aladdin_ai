# aladdin_ai 本機環境變數範本（跟後台環境無關，本機單一值）——只有 KEY，沒有值，可進 git。
# 用法：cp .env.local.example .env.local，填入真實值後 chmod 600（那份 .env.local 不可進 git）。
# 與 .env.cqa / .env.dev / .env.evi / .env.uat / .env.prod 是平行檔案——那五份放「後台
# 環境」憑證，這份只放跟環境無關的本機工具設定。conn/*.sh、lib/env.cjs 會自動合併讀取
# 全部 6 份檔案，不用手動 source。

ALD_NOTION_TOKEN=

TELEGRAM_BOT_TOKEN=

TRACKER_FILE=

ABU_API_URL=

ALADDIN_ROOT_AT_DATE=

# 本機 platform 後台（platform 1 / localhost:8002）測試帳密，見
# skills/agrabah-local-dev/SKILL.md。跟後台環境無關，純本機。
LOCAL_PLATFORM_USER=
LOCAL_PLATFORM_PASS=
